# Copy to .env.local and fill in real values. Never commit .env.local.
#
# Generated by worknode-next apps/web/scripts/create-harness-integration.ts
# (slug `harness`). Each environment has its own secret: a staging secret
# is rejected by production and vice versa.

# --- Staging -----------------------------------------------------------
EXPO_PUBLIC_WORKNODE_STAGING_API_BASE=https://staging.worknode.se
EXPO_PUBLIC_WORKNODE_STAGING_SLUG=your-partner-slug
EXPO_PUBLIC_WORKNODE_STAGING_SECRET=replace-me-with-the-staging-secret

# --- Production --------------------------------------------------------
EXPO_PUBLIC_WORKNODE_PROD_API_BASE=https://app.worknode.se
EXPO_PUBLIC_WORKNODE_PROD_SLUG=your-partner-slug
EXPO_PUBLIC_WORKNODE_PROD_SECRET=replace-me-with-the-prod-secret
